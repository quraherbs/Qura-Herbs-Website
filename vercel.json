{
  "trailingSlash": false,
  "functions": {
    "api/index.py": {
      "excludeFiles": "{backend/uploads/**,backend/venv/**,frontend/**,node_modules/**,*.db,*.db-backup,*.db-shm,*.db-wal,qura_herbs_export.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/redoc",
      "destination": "/api/index.py"
    }
  ]
}