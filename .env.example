# Database Settings
# For SQLite: sqlite:///./qura_herbs.db
# For PostgreSQL: postgresql://username:password@localhost:5432/qura_herbs
DATABASE_URL=sqlite:///./qura_herbs.db

# Admin Authentication
# Comma-separated list of admin emails allowed to access /admin
ADMIN_EMAILS=admin@quraherbs.in,quraherbs@gmail.com
ADMIN_PASSWORD=your-admin-secure-password-here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT Secret for Session Cookies
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=yourrazorpaysecret

# Email Configurations (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=info@quraherbs.in
EMAIL_PASSWORD=your-email-password

# WhatsApp Cloud API configurations
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# Google Sheets API integrations (Optional - JSON credentials string)
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"..."}
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id

# Cloudinary Storage Configurations (Optional - falls back to local storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Supabase Storage (Product & Media Uploads)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=product-images

# Frontend / API URLs
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
